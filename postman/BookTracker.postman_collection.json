{
  "info": {
    "_postman_id": "booktracker-api-v1",
    "name": "BookTracker API",
    "description": "BookTracker backend API collection. Login auto-saves the JWT token to the `token` collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5062",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Test123!\",\n  \"firstName\": \"Alexei\",\n  \"lastName\": \"Ceglei\",\n  \"dateOfBirth\": \"1995-06-15T00:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('Token saved to collection variable.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Test123!\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Me (current user)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Lookup by ISBN",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/books/9780140328721",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "9780140328721"]
            },
            "description": "Look up a book by ISBN. Checks the local catalog first; falls back to Open Library. Returns BookResponse or null (HTTP 200) if not found anywhere. Requires JWT."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Shelf",
      "item": [
        {
          "name": "Add to Shelf",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/shelf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shelf"]
            },
            "description": "Add a catalogued book to the authenticated user's shelf. Returns HTTP 201 with UserBookResponse (id, book, status, currentPages, readingNumber, startedAt, finishedAt, lastActivityAt, readerCount). Requires JWT."
          },
          "response": []
        },
        {
          "name": "Get My Shelf",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shelf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shelf"]
            },
            "description": "Get the authenticated user's shelf — most-recent UserBook per Book, ordered by lastActivityAt DESC. Returns array of UserBookResponse. Requires JWT."
          },
          "response": []
        }
      ]
    }
  ]
}
